# AI Configuration
# Preferred: Gemini API key (free tier) — https://aistudio.google.com/apikey
# Used for STT transcription + LLM classification/questions
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Vertex AI fallback (only if GEMINI_API_KEY unset)
GCP_PROJECT_ID=your-gcp-project-id

# Service Configuration
SESSION_TIMEOUT_MINUTES=60
MAX_AUDIO_DURATION_SECONDS=600
AUDIO_RETENTION_DAYS=7

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Express Backend Integration
EXPRESS_WEBHOOK_URL=http://localhost:5000/api/webhooks/interview-complete
EXPRESS_WEBHOOK_SECRET=your-webhook-secret-key

# Audio storage (local directory)
AUDIO_DIR=./data/audio

# Logging
LOG_LEVEL=INFO
ENVIRONMENT=development

# Server Configuration
PORT=8000
HOST=0.0.0.0
