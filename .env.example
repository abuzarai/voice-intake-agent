# GCP Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_CREDENTIALS_PATH=./service-account-key.json

# Gemini API (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Service Configuration
SESSION_TIMEOUT_MINUTES=60
MAX_AUDIO_DURATION_SECONDS=600
AUDIO_RETENTION_DAYS=7

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Express Backend Integration
EXPRESS_WEBHOOK_URL=http://localhost:5000/api/webhooks/interview-complete
EXPRESS_WEBHOOK_SECRET=your-webhook-secret-key

# Cloud Storage
AUDIO_STORAGE_BUCKET=interview-audio-{your-project-id}

# Logging
LOG_LEVEL=INFO
ENVIRONMENT=development

# Server Configuration
PORT=8000
HOST=0.0.0.0
